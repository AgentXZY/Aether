```gitignore
# Maven
target/

# IntelliJ
.idea/
*.iml

# VSCode
.vscode/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Environment / secrets
.env
.env.*
application-secret.properties
application-local.properties

# Chat history / runtime generated data
chat-logs/

# Local database files
database/

